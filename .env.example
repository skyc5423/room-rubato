# Public client configuration. Never place service_role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Required for the existing Room Rubato database, whose direct writes are revoked.
# These are BUILD-TIME public flags. Use only after catalog preflight confirms CAS RPCs.
# Do not turn CAS off as a routine rollback; choose a CAS-compatible build instead.
NEXT_PUBLIC_PERSONA_CAS_ENABLED=true
NEXT_PUBLIC_TASTE_CLOUD_SYNC=true
# SMTP/recovery/delivery launch gate remains closed. This is not an Auth provider setting.
NEXT_PUBLIC_EMAIL_SIGNUP_ENABLED=false
